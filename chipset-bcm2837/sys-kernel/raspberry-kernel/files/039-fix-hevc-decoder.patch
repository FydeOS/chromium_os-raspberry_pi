--- kernel-rpi.orig/arch/arm/boot/dts/broadcom/bcm2711-rpi-ds.dtsi
+++ kernel-rpi/arch/arm/boot/dts/broadcom/bcm2711-rpi-ds.dtsi
@@ -78,8 +78,11 @@
 };
 
 &cma {
-	/* Limit cma to the lower 768MB to allow room for HIGHMEM on 32-bit */
-	alloc-ranges = <0x0 0x00000000 0x30000000>;
+	/*
+	 * On arm64 (no HIGHMEM), use the full 1GB ZONE_DMA range.
+	 * On 32-bit this was 0x30000000 to leave room for HIGHMEM.
+	 */
+	alloc-ranges = <0x0 0x00000000 0x40000000>;
 };
 
