+/* The vc4 device, published for v3d's VC4_CALLOC path so it can allocate
+ * scanout-capable (CMA) buffers.  vc4_drm_lock makes publish/withdraw atomic
+ * against vc4_drm_get(), so a caller can never be handed a pointer that is
+ * freed out from under it.
+ */
+static DEFINE_MUTEX(vc4_drm_lock);
+struct drm_device *vc4_drm;
