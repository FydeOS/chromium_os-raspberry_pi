-struct drm_file *vc4_drm_file = NULL;
-EXPORT_SYMBOL(vc4_drm_file);
+
+/**
+ * vc4_drm_get - get a counted reference to the vc4 DRM device
+ *
+ * Returns the device with a reference taken, or NULL if vc4 is not bound.
+ * The caller must drm_dev_put() it.  Note this only keeps the allocation
+ * alive; pair it with drm_dev_enter()/drm_dev_exit() to also exclude the
+ * device having been unplugged.
+ */
+struct drm_device *vc4_drm_get(void)
+{
+	struct drm_device *drm;
+
+	mutex_lock(&vc4_drm_lock);
+	drm = vc4_drm;
+	if (drm)
+		drm_dev_get(drm);
+	mutex_unlock(&vc4_drm_lock);
+
+	return drm;
+}
+EXPORT_SYMBOL(vc4_drm_get);
 
