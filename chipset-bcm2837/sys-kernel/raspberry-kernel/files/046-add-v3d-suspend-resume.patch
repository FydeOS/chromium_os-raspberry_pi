===================================================================
--- v6.12-rpi.orig/drivers/gpu/drm/v3d/v3d_drv.c
+++ v6.12-rpi/drivers/gpu/drm/v3d/v3d_drv.c
@@ -520,11 +520,64 @@ static void v3d_platform_drm_remove(stru
 	clk_disable_unprepare(v3d->clk);
 }
 
+static int v3d_suspend(struct device *dev)
+{
+	struct drm_device *drm = dev_get_drvdata(dev);
+	struct v3d_dev *v3d = to_v3d_dev(drm);
+
+	/*
+	 * Userspace is frozen by the PM core before this runs, so no new
+	 * jobs can be submitted.  Quiesce the GPU and drop its power island
+	 * (SMS, on V3D >= 7.1) and clock.  Any job still in flight is
+	 * recovered by the scheduler timeout after resume, once the hardware
+	 * has been reprogrammed below.
+	 */
+	v3d_irq_disable(v3d);
+	v3d_power_off_sms(v3d);
+	clk_disable_unprepare(v3d->clk);
+
+	return 0;
+}
+
+static int v3d_resume(struct device *dev)
+{
+	struct drm_device *drm = dev_get_drvdata(dev);
+	struct v3d_dev *v3d = to_v3d_dev(drm);
+	int ret;
+
+	ret = clk_prepare_enable(v3d->clk);
+	if (ret) {
+		dev_err(dev, "Failed to re-enable the V3D clock on resume\n");
+		return ret;
+	}
+
+	/*
+	 * The V3D power island (SMS, on V3D >= 7.1) and all core/MMU state
+	 * are lost across system suspend.  Re-run the same hardware bring-up
+	 * that probe performs: power the SMS back up FIRST -- without this the
+	 * SMS reset issued during hang recovery times out ("Failed to wait for
+	 * SMS reset") and the GPU is left permanently wedged -- then reprogram
+	 * the core, page table and interrupts.
+	 */
+	v3d_idle_sms(v3d);
+	v3d_init_hw_state(v3d);
+	v3d_mmu_set_page_table(v3d);
+	v3d_irq_reset(v3d);
+
+	ret = clk_set_min_rate(v3d->clk, v3d->clk_down_rate);
+	WARN_ON_ONCE(ret != 0);
+
+	return 0;
+}
+
+static DEFINE_SIMPLE_DEV_PM_OPS(v3d_pm_ops, v3d_suspend, v3d_resume);
+
 static struct platform_driver v3d_platform_driver = {
 	.probe		= v3d_platform_drm_probe,
 	.remove_new	= v3d_platform_drm_remove,
 	.driver		= {
 		.name	= "v3d",
+		.pm	= pm_sleep_ptr(&v3d_pm_ops),
 		.of_match_table = v3d_of_match,
 	},
 };
