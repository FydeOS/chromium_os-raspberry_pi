+	 * If another thread already allocated a table for an index, free ours.
 	 */
 	spin_lock_irqsave(&mmu->hw_lock, flags);
-	for (lxp = (p >> LX_PAGEWORDS_SHIFT);
-	     lxp <= (p_last >> LX_PAGEWORDS_SHIFT); lxp++) {
+	lxp_idx = 0;
+	for (lxp = lxp_start; lxp <= lxp_end; lxp++) {
 		if (!mmu->tables[lxp]) {
-			unsigned int i, u;
+			unsigned int i;
+			u32 u;
+
+			/* Use pre-allocated page */
+			mmu->tables[lxp] = new_tables[lxp_idx];
+			u = new_dma_addrs[lxp_idx];
+			new_tables[lxp_idx] = NULL; /* Mark as used */
+			lxp_idx++;
 
-			u = bcm2712_iommu_get_page(mmu, &mmu->tables[lxp]);
-			if (!u)
-				break;
 			u |= MMMU_PTE_VALID;
 			if (!dirty_top) {
 				dma_sync_single_for_cpu(mmu->dev, virt_to_phys(mmu->top_table),
@@ -308,12 +355,20 @@ static int bcm2712_iommu_map(struct iomm
 	if (dirty_top)
 		dma_sync_single_for_device(mmu->dev, virt_to_phys(mmu->top_table),
 					   PAGE_SIZE, DMA_TO_DEVICE);
-	if (lxp <= (p_last >> LX_PAGEWORDS_SHIFT)) {
-		spin_unlock_irqrestore(&mmu->hw_lock, flags);
-		*mapped = 0;
-		return -ENOMEM;
+	spin_unlock_irqrestore(&mmu->hw_lock, flags);
+
+	/* Free any unused pre-allocated pages (race condition case) */
+	if (new_tables) {
+		for (lxp_idx = 0; lxp_idx < num_new_tables; lxp_idx++) {
+			if (new_tables[lxp_idx])
+				bcm2712_iommu_free_page(mmu, new_tables[lxp_idx]);
+		}
+		kfree(new_tables);
+		kfree(new_dma_addrs);
 	}
 
+	spin_lock_irqsave(&mmu->hw_lock, flags);
+
 	/* large page and write enable flags */
 	if (!(align & ((1 << IOMMU_HUGEPAGE_SHIFT) - 1)))
 		entry |= FIELD_PREP(MMMU_PTE_PAGESIZE_MASK, 3);
