@@ -277,22 +282,64 @@ static int bcm2712_iommu_map(struct iomm
 	iova -= mmu->aperture_base;
 	p = iova >> IOMMU_PAGE_SHIFT;
 	p_last = (iova + bytes - 1) >> IOMMU_PAGE_SHIFT;
+	lxp_start = p >> LX_PAGEWORDS_SHIFT;
+	lxp_end = p_last >> LX_PAGEWORDS_SHIFT;
 
 	/*
-	 * Check we have allocated the required Level-2 tables (in units of
-	 * whole Linux pages, each covering one or more IOMMU-table pages).
-	 * Any new L2 pages need to be linked to the top-level table.
-	 * A failure here will cause the entire map_pages() call to fail.
+	 * Pre-allocate any required Level-2 tables BEFORE taking the spinlock.
+	 * This avoids sleeping in atomic context. We allocate for all indices
+	 * where mmu->tables[lxp] is currently NULL. If another thread races
+	 * and allocates the same table, we'll free the duplicate later.
+	 */
+	for (lxp = lxp_start; lxp <= lxp_end; lxp++) {
+		if (!mmu->tables[lxp])
+			num_new_tables++;
+	}
+
+	if (num_new_tables > 0) {
+		new_tables = kcalloc(num_new_tables, sizeof(u32 *), gfp);
+		new_dma_addrs = kcalloc(num_new_tables, sizeof(u32), gfp);
+		if (!new_tables || !new_dma_addrs) {
+			kfree(new_tables);
+			kfree(new_dma_addrs);
+			*mapped = 0;
+			return -ENOMEM;
+		}
+
+		for (lxp_idx = 0; lxp_idx < num_new_tables; lxp_idx++) {
+			new_dma_addrs[lxp_idx] = bcm2712_iommu_get_page(mmu,
+						&new_tables[lxp_idx], gfp);
+			if (!new_dma_addrs[lxp_idx]) {
+				/* Free already allocated pages */
+				while (lxp_idx > 0) {
+					lxp_idx--;
+					bcm2712_iommu_free_page(mmu, new_tables[lxp_idx]);
+				}
+				kfree(new_tables);
+				kfree(new_dma_addrs);
+				*mapped = 0;
+				return -ENOMEM;
+			}
+		}
+	}
+
+	/*
