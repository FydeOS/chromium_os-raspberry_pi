Index: v6.12-rpi/kernel/bpf/inode.c
===================================================================
--- v6.12-rpi.orig/kernel/bpf/inode.c
+++ v6.12-rpi/kernel/bpf/inode.c
@@ -1014,8 +1014,17 @@ static int bpf_fill_super(struct super_b
 	struct inode *inode;
 	int ret;
 
-	/* Mounting an instance of BPF FS requires privileges */
-	if (fc->user_ns != &init_user_ns && !capable(CAP_SYS_ADMIN))
+	/*
+	 * Mounting an instance of BPF FS requires privileges over the user
+	 * namespace that will own the superblock. Upstream requires init-ns
+	 * CAP_SYS_ADMIN here; fydroid relaxes it to ns_capable() so the ARC++
+	 * (Android 13) container can mount its own bpffs from inside its user
+	 * namespace -- Android 13 netd hard-requires a writable /sys/fs/bpf for
+	 * the in-container bpfloader. This matches the FS_USERNS_MOUNT idiom
+	 * already used by tmpfs/cgroup2. RE-CHECK ON KERNEL UPREV.
+	 */
+	if (fc->user_ns != &init_user_ns &&
+	    !ns_capable(fc->user_ns, CAP_SYS_ADMIN))
 		return -EPERM;
 
 	ret = simple_fill_super(sb, BPF_FS_MAGIC, bpf_rfiles);
Index: v6.12-rpi/kernel/bpf/token.c
===================================================================
--- v6.12-rpi.orig/kernel/bpf/token.c
+++ v6.12-rpi/kernel/bpf/token.c
@@ -17,8 +17,20 @@ bool bpf_token_capable(const struct bpf_
