 	struct user_namespace *userns;
 
-	/* BPF token allows ns_capable() level of capabilities */
-	userns = token ? token->userns : &init_user_ns;
+	/*
+	 * BPF token allows ns_capable() level of capabilities over the user
+	 * namespace that owns the bpffs the token was minted from. With no
+	 * token, upstream falls back to init_user_ns -- which a child-userns
+	 * container (e.g. the ARC++ Android 13 container) can never satisfy, so
+	 * its tokenless bpf() syscalls (BPF_MAP_CREATE / BPF_PROG_LOAD /
+	 * BPF_PROG_ATTACH) get EPERM even though it holds CAP_SYS_ADMIN/CAP_BPF
+	 * in its own userns. fydroid falls back to current_user_ns() so the A13
+	 * bpfloader (which does not use BPF tokens) can load its networking
+	 * programs. In init_user_ns this is identical to upstream behaviour.
+	 * SECURITY: any userns root with CAP_BPF/CAP_SYS_ADMIN over its own
+	 * userns can now drive the BPF verifier. RE-CHECK ON KERNEL UPREV.
+	 */
+	userns = token ? token->userns : current_user_ns();
 	if (!bpf_ns_capable(userns, cap))
 		return false;
 	if (token && security_bpf_token_capable(token, cap) < 0)
