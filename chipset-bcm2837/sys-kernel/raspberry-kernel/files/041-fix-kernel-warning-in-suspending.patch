@@ -1675,6 +1682,72 @@ out_iounmap:
 	return err;
 }
 
+static int rp1_pinctrl_suspend(struct device *dev)
+{
+	struct rp1_pinctrl *pc = dev_get_drvdata(dev);
+	int i;
+
+	for (i = 0; i < RP1_NUM_GPIOS; i++) {
+		struct rp1_pin_info *pin = &pc->pins[i];
+
+		pc->gpio_ctrl_saved[i] = readl(pin->gpio + RP1_GPIO_CTRL);
+		pc->pad_saved[i] = readl(pin->pad);
+	}
+
+	for (i = 0; i < RP1_NUM_BANKS; i++) {
+		const struct rp1_iobank_desc *bank = &rp1_iobanks[i];
+		void __iomem *rio = pc->rio_base + bank->rio_offset;
+
+		pc->rio_out_saved[i] = readl(rio + RP1_RIO_OUT);
+		pc->rio_oe_saved[i] = readl(rio + RP1_RIO_OE);
+		pc->inte_saved[i] = readl(pc->gpio_base + bank->inte_offset);
+	}
+
+	return 0;
+}
+
+static int rp1_pinctrl_resume(struct device *dev)
+{
+	struct rp1_pinctrl *pc = dev_get_drvdata(dev);
+	int i;
+
+	/* Restore pad configs first (drive strength, pull, etc.) */
+	for (i = 0; i < RP1_NUM_GPIOS; i++) {
+		struct rp1_pin_info *pin = &pc->pins[i];
+
+		writel(pc->pad_saved[i], pin->pad);
+	}
+
+	/* Restore output values before enabling outputs */
+	for (i = 0; i < RP1_NUM_BANKS; i++) {
+		const struct rp1_iobank_desc *bank = &rp1_iobanks[i];
+		void __iomem *rio = pc->rio_base + bank->rio_offset;
+
+		writel(pc->rio_out_saved[i], rio + RP1_RIO_OUT);
+		writel(pc->rio_oe_saved[i], rio + RP1_RIO_OE);
+	}
+
+	/* Restore GPIO mux and control (funcsel, overrides, irq enables) */
+	for (i = 0; i < RP1_NUM_GPIOS; i++) {
+		struct rp1_pin_info *pin = &pc->pins[i];
+
+		writel(pc->gpio_ctrl_saved[i], pin->gpio + RP1_GPIO_CTRL);
+	}
+
+	/* Restore interrupt enables */
+	for (i = 0; i < RP1_NUM_BANKS; i++) {
+		const struct rp1_iobank_desc *bank = &rp1_iobanks[i];
+
+		writel(pc->inte_saved[i], pc->gpio_base + bank->inte_offset);
+	}
+
+	return 0;
+}
+
+static DEFINE_SIMPLE_DEV_PM_OPS(rp1_pinctrl_pm_ops,
+				rp1_pinctrl_suspend,
+				rp1_pinctrl_resume);
+
 static void rp1_pinctrl_remove(struct platform_device *pdev)
 {
 	struct rp1_pinctrl *pc = platform_get_drvdata(pdev);
@@ -1690,6 +1763,7 @@ static struct platform_driver rp1_pinctr
 		.name = MODULE_NAME,
 		.of_match_table = rp1_pinctrl_match,
 		.suppress_bind_attrs = true,
+		.pm = pm_sleep_ptr(&rp1_pinctrl_pm_ops),
 	},
 };
