+static int rp1_suspend(struct device *dev)
+{
+	struct rp1_dev *rp1 = dev_get_drvdata(dev);
+	int i;
+
+	for (i = 0; i < RP1_IRQS; i++)
+		rp1->msix_cfg_saved[i] = readl(rp1->msix_cfg_regs + MSIX_CFG(i));
+
+	return 0;
+}
+
+static int rp1_resume(struct device *dev)
+{
+	struct rp1_dev *rp1 = dev_get_drvdata(dev);
+	u32 chip_id;
+	int i, retries;
+
+	/* Re-trigger RP1 firmware initialisation after PCIe power cycle */
+	reset_control_reset(rp1->reset);
+
+	/*
+	 * Wait for RP1 firmware to finish initialising after power-on.
+	 * The firmware writes the chip ID to SYSINFO when ready.
+	 */
+	for (retries = 0; retries < 100; retries++) {
+		chip_id = rp1_reg_read(rp1, RP1_SYSINFO_BASE,
+				       SYSINFO_CHIP_ID_OFFSET);
+		if (chip_id == RP1_C0_CHIP_ID)
+			break;
+		msleep(10);
+	}
+	if (chip_id != RP1_C0_CHIP_ID)
+		dev_warn(rp1->dev,
+			 "RP1 firmware not ready after resume (chip_id=0x%x)\n",
+			 chip_id);
+
+	for (i = 0; i < RP1_IRQS; i++)
+		writel(rp1->msix_cfg_saved[i], rp1->msix_cfg_regs + MSIX_CFG(i));
+
+	return 0;
+}
+
+static DEFINE_SIMPLE_DEV_PM_OPS(rp1_pm_ops, rp1_suspend, rp1_resume);
+
 static const struct pci_device_id dev_id_table[] = {
 	{ PCI_DEVICE(PCI_VENDOR_ID_RPI, PCI_DEVICE_ID_RP1_C0), },
 	{ 0, }
@@ -366,6 +414,7 @@ static struct pci_driver rp1_driver = {
 	.id_table	= dev_id_table,
 	.probe		= rp1_probe,
 	.remove		= rp1_remove,
+	.driver.pm	= pm_sleep_ptr(&rp1_pm_ops),
 };
 
 module_pci_driver(rp1_driver);
