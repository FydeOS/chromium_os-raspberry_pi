+
+	/* Saved state for suspend/resume */
+	u32 gpio_ctrl_saved[RP1_NUM_GPIOS];
+	u32 pad_saved[RP1_NUM_GPIOS];
+	u32 rio_out_saved[RP1_NUM_BANKS];
+	u32 rio_oe_saved[RP1_NUM_BANKS];
+	u32 inte_saved[RP1_NUM_BANKS];
 };
 
