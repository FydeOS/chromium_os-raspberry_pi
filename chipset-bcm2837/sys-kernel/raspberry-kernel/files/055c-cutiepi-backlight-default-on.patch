Index: v6.12-rpi/drivers/video/backlight/pwm_bl.c
===================================================================
--- v6.12-rpi.orig/drivers/video/backlight/pwm_bl.c
+++ v6.12-rpi/drivers/video/backlight/pwm_bl.c
@@ -400,6 +400,17 @@ static int pwm_backlight_initial_power_s
 	bool active = true;
 
 	/*
+	 * If the DT node carries the 'default-on' property, start powered on
+	 * unconditionally.  This is needed when the backlight node has no
+	 * consumer phandle (so no driver will call backlight_enable() later)
+	 * but still has a phandle value assigned by dtc, which would otherwise
+	 * cause this function to observe an inactive PWM and return
+	 * BACKLIGHT_POWER_OFF.
+	 */
+	if (of_property_read_bool(node, "default-on"))
+		return BACKLIGHT_POWER_ON;
+
+	/*
 	 * If the enable GPIO is present, observable (either as input
 	 * or output) and off then the backlight is not currently active.
 	 * */
