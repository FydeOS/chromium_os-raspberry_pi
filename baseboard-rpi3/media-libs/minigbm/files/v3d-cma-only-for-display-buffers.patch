-	(BO_USE_SW_MASK | BO_USE_SCANOUT | BO_USE_LINEAR | BO_USE_HW_VIDEO_DECODER |                \
-	 BO_USE_HW_VIDEO_ENCODER)
+
+/*
+ * Which buffers actually have to come out of CMA.
+ *
+ * BCM2711/BCM2712 put no IOMMU in front of the codec and camera blocks: the
+ * VPU / rpivid / unicam V4L2 devices are all videobuf2-dma-contig, so buffers
+ * those engines walk must be physically contiguous, which on a Pi means CMA.
+ * They have no software fallback either, so a failure here must be loud.
+ *
+ * v3d itself has an MMU, so a buffer that is only rendered, textured or read by
+ * the CPU does not need CMA -- and must not take any, because CMA is a small
+ * fixed pool (dtoverlay=vc4-kms-v3d-pi4,cma-512) that is at the same time the
+ * only source of scanout memory. A 4K framebuffer needs 32 MiB of it in one
+ * piece, so letting ordinary GPU/CPU buffers fill and fragment the pool is what
+ * leaves a 4K display unable to allocate a framebuffer at all (FYDE-571).
+ */
+#define V3D_CONTIGUOUS_REQUIRED                                                                    \
+	(BO_USE_HW_VIDEO_DECODER | BO_USE_HW_VIDEO_ENCODER | BO_USE_CAMERA_READ |                   \
+	 BO_USE_CAMERA_WRITE | BO_USE_SENSOR_DIRECT_DATA)
+
+/*
+ * The display/cursor half: buffers a KMS plane would scan out. These are a SOFT
+ * requirement -- if CMA cannot satisfy them we still hand back a usable buffer,
+ * it just gets composited by the GPU instead of promoted to a hardware plane.
+ *
+ * On Android this set is deliberately EMPTY. fydroid's SurfaceFlinger is built
+ * with a factory that swaps HWComposer for a Wayland composer
+ * (FydroidSurfaceFlingerFactory.cpp) and no hwcomposer HAL is packaged, so
+ * Android never programs a KMS plane: every window buffer is exported as a
+ * dma-buf and handed to Chrome, which owns the display. But
+ * cros_gralloc_helpers.cc still maps GRALLOC_USAGE_HW_COMPOSER to
+ * BO_USE_SCANOUT | BO_USE_TEXTURE, and SurfaceFlinger sets that on essentially
+ * every layer -- the 4K surface that failed in FYDE-571 had usage 0xb00
+ * (HW_COMPOSER | HW_RENDER | HW_TEXTURE). Honouring SCANOUT here therefore puts
+ * *every ARC window buffer* in CMA, which is what exhausted the pool.
+ *
+ * This cannot be fixed in cros_gralloc_helpers.cc under #ifdef DRV_V3D:
+ * BOARD_MINIGBM_DRIVERS for fydroid-rt_arm64 is "rockchip v3d vc4 realtek", so
+ * a single image carries backends that do drive real scanout hardware and do
+ * depend on BO_USE_SCANOUT. The decision has to stay backend-local, here.
+ *
+ * To restore the old behaviour (e.g. if Chrome turns out to want ARC buffers on
+ * a hardware overlay after all), give this the non-Android definition.
+ */
+#ifdef __ANDROID__
+#define V3D_CONTIGUOUS_SOFT 0
+#else
+#define V3D_CONTIGUOUS_SOFT (BO_USE_SCANOUT | BO_USE_CURSOR)
+#endif
+
+#define V3D_CONTIGUOUS_USE (V3D_CONTIGUOUS_REQUIRED | V3D_CONTIGUOUS_SOFT)
+
+/*
+ * UIF tiling is private to v3d. Any buffer the CPU maps or another device reads
+ * has to stay linear, whether or not it ends up in CMA -- dropping a buffer out
+ * of CMA must not change the layout its user already agreed to. Spelled out in
+ * full rather than derived from V3D_CONTIGUOUS_USE on purpose: narrowing what
+ * goes to CMA must never narrow what stays linear.
+ */
+#define V3D_LINEAR_USE                                                                             \
+	(BO_USE_NON_GPU_HW | BO_USE_CURSOR | BO_USE_SW_MASK | BO_USE_LINEAR |                       \
+	 BO_USE_GPU_DATA_BUFFER | BO_USE_RENDERSCRIPT | BO_USE_PROTECTED)
 
