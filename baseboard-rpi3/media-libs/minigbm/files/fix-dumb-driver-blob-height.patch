--- a/drv_helpers.c
+++ b/drv_helpers.c
@@ -405,9 +405,16 @@
 		case DRM_FORMAT_YVU420_ANDROID:
 			break;
 		default:
-			/* Align for llvmpipe 64-byte tile size for dumb_driver */
-			aligned_width = ALIGN(aligned_width, MESA_LLVMPIPE_TILE_SIZE);
-			aligned_height = ALIGN(aligned_height, MESA_LLVMPIPE_TILE_SIZE);
+			if (aligned_height == 1) {
+				/* 1D blob buffers (e.g. JPEG as R8 w=max_jpeg_size h=1)
+				 * must not be height-aligned; 64x inflation turns ~13MB
+				 * into ~832MB, causing ENOMEM on CMA-backed allocators. */
+				aligned_width = ALIGN(aligned_width, 64);
+			} else {
+				/* Align for llvmpipe 64-byte tile size for dumb_driver */
+				aligned_width = ALIGN(aligned_width, MESA_LLVMPIPE_TILE_SIZE);
+				aligned_height = ALIGN(aligned_height, MESA_LLVMPIPE_TILE_SIZE);
+			}
 			break;
 		}
 	}
