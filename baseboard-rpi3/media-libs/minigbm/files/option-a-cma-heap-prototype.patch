+/*
+ * Open the CMA dma-buf heap. The default CMA area is exported by
+ * drivers/dma-buf/heaps/cma_heap.c as /dev/dma_heap/<cma-area-name>; the name
+ * varies by devicetree ("linux,cma", "reserved", ...), so try the common
+ * names and then fall back to scanning for any non-system heap.
+ */
+static int v3d_open_cma_heap(void)
+{
+	static const char *const candidates[] = {
+		"/dev/dma_heap/linux,cma",
+		"/dev/dma_heap/reserved",
+		"/dev/dma_heap/linux,cma-default",
+	};
+	DIR *dir;
+	struct dirent *ent;
+	int fd;
+	size_t i;
+
+	for (i = 0; i < ARRAY_SIZE(candidates); i++) {
+		fd = open(candidates[i], O_RDWR | O_CLOEXEC);
+		if (fd >= 0) {
+			drv_logi("v3d: using CMA dma-heap %s\n", candidates[i]);
+			return fd;
+		}
+	}
+
+	/* Fallback: first heap that is not the (non-contiguous) system heap. */
+	dir = opendir("/dev/dma_heap");
+	if (!dir)
+		return -1;
+	while ((ent = readdir(dir))) {
+		char path[256];
+		if (ent->d_name[0] == '.' || !strcmp(ent->d_name, "system"))
+			continue;
+		snprintf(path, sizeof(path), "/dev/dma_heap/%s", ent->d_name);
+		fd = open(path, O_RDWR | O_CLOEXEC);
+		if (fd >= 0) {
+			drv_logi("v3d: using CMA dma-heap %s\n", path);
+			closedir(dir);
+			return fd;
+		}
+	}
+	closedir(dir);
+	return -1;
+}
