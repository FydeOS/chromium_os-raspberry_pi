+/*
+ * Allocate a contiguous linear buffer from the CMA dma-heap and import it into
+ * v3d so the GPU can render into it. On success bo->handle.u32 is the v3d GEM
+ * handle and *out_priv owns the dma-buf fd used for CPU map / export / sync.
+ */
+static int v3d_alloc_from_heap(struct bo *bo, int heap_fd, struct v3d_bo_priv **out_priv)
+{
+	struct dma_heap_allocation_data alloc = {
+		.len = bo->meta.total_size,
+		.fd_flags = O_RDWR | O_CLOEXEC,
+	};
+	struct v3d_bo_priv *priv;
+	uint32_t handle = 0;
+	int ret;
+
+	ret = ioctl(heap_fd, DMA_HEAP_IOCTL_ALLOC, &alloc);
+	if (ret) {
+		drv_loge("v3d: DMA_HEAP_IOCTL_ALLOC failed size=%zu: %s\n", bo->meta.total_size,
+			 strerror(errno));
+		return -errno;
+	}
+
+	/* Import the CMA dma-buf into v3d's GPU address space (standard PRIME). */
+	ret = drmPrimeFDToHandle(bo->drv->fd, alloc.fd, &handle);
+	if (ret) {
+		drv_loge("v3d: PRIME import of heap buffer failed: %s\n", strerror(errno));
+		close(alloc.fd);
+		return -errno;
+	}
+
+	priv = calloc(1, sizeof(*priv));
+	if (!priv) {
+		struct drm_gem_close gem_close = { .handle = handle };
+		drmIoctl(bo->drv->fd, DRM_IOCTL_GEM_CLOSE, &gem_close);
+		close(alloc.fd);
+		return -ENOMEM;
+	}
+
+	priv->dmabuf_fd = alloc.fd;
+	bo->handle.u32 = handle;
+	bo->meta.format_modifier = DRM_FORMAT_MOD_LINEAR;
+	bo->meta.tiling = V3D_TILING_RASTER;
+	*out_priv = priv;
+	return 0;
+}
 
