+/* dma-buf CPU-access sync for heap-backed buffers. */
+static int v3d_heap_sync(struct bo *bo, bool start, uint32_t map_flags)
+{
+	struct v3d_bo_priv *bpriv = bo->priv;
+	struct dma_buf_sync sync = { 0 };
+
+	if (!bpriv)
+		return 0;
+
+	sync.flags = start ? DMA_BUF_SYNC_START : DMA_BUF_SYNC_END;
+	if (map_flags & BO_MAP_READ)
+		sync.flags |= DMA_BUF_SYNC_READ;
+	if (map_flags & BO_MAP_WRITE)
+		sync.flags |= DMA_BUF_SYNC_WRITE;
+
+	return ioctl(bpriv->dmabuf_fd, DMA_BUF_IOCTL_SYNC, &sync) ? -errno : 0;
+}
