+  // buffer cost per stream is:
+  //
+  //   1080p  8 * 2.99MB (NC12 CAPTURE) + 16 * 2.97MB (NV12 pool) =  71MB
+  //   2K     8 * 5.27MB                + 16 * 5.27MB             = 127MB
+  //   4K     8 * 11.95MB               + 16 * 11.87MB            = 286MB
+  //
+  // So 1080p and 2K fit at full depth with margin, while 4K does not fit at
+  // all and needs the reduced pool (~214MB) just to have a chance.
+  //
+  // Reducing below 2K is not merely unnecessary, it is harmful: an H.264
+  // 1080p stream at ~24fps drains a 17-frame pool faster than frames are
+  // returned, after which the driver signals POLLERR continuously and
+  // playback dies a few seconds in.
+  constexpr int k2KArea = 2560 * 1440;
+  const bool reduce_buffers =
