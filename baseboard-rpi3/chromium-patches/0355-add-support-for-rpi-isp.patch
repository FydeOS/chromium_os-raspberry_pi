Index: src/media/gpu/v4l2/vcsm_cma_utils.cc
===================================================================
--- /dev/null
+++ src/media/gpu/v4l2/vcsm_cma_utils.cc
@@ -0,0 +1,225 @@
+// Copyright 2024 The FydeOS Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "media/gpu/v4l2/vcsm_cma_utils.h"
+
+#include <fcntl.h>
+#include <linux/ioctl.h>
+#include <string.h>
+#include <sys/ioctl.h>
+#include <unistd.h>
+
+#include <vector>
+
+#include "base/logging.h"
+#include "base/posix/eintr_wrapper.h"
+#include "media/base/color_plane_layout.h"
+#include "media/base/video_frame_layout.h"
+#include "media/base/video_types.h"
+#include "media/gpu/chromeos/native_pixmap_frame_resource.h"
+#include "media/gpu/macros.h"
+#include "ui/gfx/native_pixmap_handle.h"
+
+namespace media {
+
+namespace {
+
+// VCSM-CMA ioctl definitions from the RPi kernel.
+// Copied from linux/broadcom/vc_sm_cma_ioctl.h to avoid kernel header
+// dependency.
+
+constexpr uint32_t kVcSmCmaResourceNameLen = 32;
+constexpr char kVcSmCmaMagicType = 'J';
+constexpr uint32_t kVcSmCmaCmdAlloc = 0x5A;
+
+// Cache type: no caching (DMA coherent).
+constexpr uint32_t kVcSmCmaCacheNone = 0;
+
+struct VcSmCmaIoctlAlloc {
+  // user -> kernel
+  uint32_t size;
+  uint32_t num;
+  uint32_t cached;
+  uint32_t pad;
+  uint8_t name[kVcSmCmaResourceNameLen];
+  // kernel -> user
+  int32_t handle;       // DMABUF fd
+  uint32_t vc_handle;   // VideoCore handle
+  uint64_t dma_addr;    // DMA address
+};
+
+// The kernel uses _IOR (matching the actual driver implementation).
+#define VCSM_CMA_IOCTL_MEM_ALLOC \
+  _IOR(kVcSmCmaMagicType, kVcSmCmaCmdAlloc, struct VcSmCmaIoctlAlloc)
+
+constexpr const char kVcsmCmaDevicePath[] = "/dev/vcsm-cma";
+
+template <typename T>
+constexpr T AlignUp(T value, T alignment) {
+  return (value + alignment - 1) & ~(alignment - 1);
+}
+
+}  // namespace
+
+VcsmCmaAllocator::VcsmCmaAllocator() {
+  vcsm_fd_.reset(HANDLE_EINTR(open(kVcsmCmaDevicePath, O_RDWR | O_CLOEXEC)));
+  if (!vcsm_fd_.is_valid()) {
+    VPLOG(1) << "Failed to open " << kVcsmCmaDevicePath;
+  } else {
+    VLOGF(1) << "Opened " << kVcsmCmaDevicePath << " fd=" << vcsm_fd_.get();
+  }
+}
+
+VcsmCmaAllocator::~VcsmCmaAllocator() {
+  VLOGF(1) << "VcsmCmaAllocator destroyed: total_allocs=" << alloc_count_.load()
+           << " still_alive=" << alive_count_.load();
+  if (alive_count_.load() > 0) {
+    LOG(WARNING) << "VCSM-CMA: " << alive_count_.load()
+                 << " buffers still alive at allocator destruction";
+  }
+}
+
+bool VcsmCmaAllocator::IsValid() const {
+  return vcsm_fd_.is_valid();
+}
+
+base::ScopedFD VcsmCmaAllocator::AllocateBuffer(uint32_t size,
+                                                 const char* name) {
+  if (!IsValid()) {
+    LOG(ERROR) << "VCSM-CMA device not open";
+    return base::ScopedFD();
+  }
+
+  VcSmCmaIoctlAlloc alloc = {};
+  alloc.size = size;
+  alloc.num = 1;
+  alloc.cached = kVcSmCmaCacheNone;
+  if (name) {
+    strncpy(reinterpret_cast<char*>(alloc.name), name,
+            kVcSmCmaResourceNameLen - 1);
+  }
+
+  int ret =
+      HANDLE_EINTR(ioctl(vcsm_fd_.get(), VCSM_CMA_IOCTL_MEM_ALLOC, &alloc));
+  if (ret < 0) {
+    VPLOG(1) << "VCSM_CMA_IOCTL_MEM_ALLOC failed for size=" << size;
+    return base::ScopedFD();
+  }
+
+  int alloc_id = alloc_count_.fetch_add(1) + 1;
+  VLOGF(1) << "VCSM-CMA allocated: size=" << size
+           << " dmabuf_fd=" << alloc.handle << " vc_handle=0x" << std::hex
+           << alloc.vc_handle << " dma_addr=0x" << alloc.dma_addr
+           << std::dec << " alloc_id=" << alloc_id;
+
+  return base::ScopedFD(alloc.handle);
+}
+
+CroStatus::Or<scoped_refptr<FrameResource>> VcsmCmaAllocator::CreateFrame(
+    VideoPixelFormat format,
+    const gfx::Size& coded_size,
+    const gfx::Rect& visible_rect,
+    const gfx::Size& natural_size,
+    bool use_protected,
+    bool use_linear_buffers,
+    bool needs_detiling,
+    base::TimeDelta timestamp) {
+  if (format != PIXEL_FORMAT_NV12) {
+    LOG(ERROR) << "VCSM-CMA allocator only supports NV12, got "
+               << VideoPixelFormatToString(format);
+    return CroStatus::Codes::kFailedToCreateVideoFrame;
+  }
+
+  if (use_protected) {
+    LOG(ERROR) << "VCSM-CMA does not support protected buffers";
+    return CroStatus::Codes::kFailedToCreateVideoFrame;
+  }
+
+  const size_t width = static_cast<size_t>(coded_size.width());
+  const size_t height = static_cast<size_t>(coded_size.height());
+
+  // NC12 (NV12_COL128) buffer layout matching the RPi kernel drivers:
+  //   width aligned to 128 bytes (column width)
+  //   height aligned to 8 lines
+  //   column_height = ALIGN(aligned_height * 3/2, 32)
+  //     Both the HEVC decoder (hevc_d) and the ISP (bcm2835-codec) align
+  //     the column height (bytesperline) to 32 so the column stride is
+  //     consistent between the decoder output and ISP input.
+  //   sizeimage = column_height * aligned_width
+  const size_t aligned_width = AlignUp<size_t>(width, 128);
+  const size_t aligned_height = AlignUp<size_t>(height, 8);
+  const size_t column_height = AlignUp<size_t>(aligned_height * 3 / 2, 32);
+  const size_t total_size =
+      AlignUp<size_t>(column_height * aligned_width, 4096);
+
+  VLOGF(2) << "VCSM-CMA frame: " << width << "x" << height
+           << " aligned=" << aligned_width << "x" << aligned_height
+           << " column_height=" << column_height
+           << " total=" << total_size;
+
+  base::ScopedFD dmabuf_fd = AllocateBuffer(total_size, "video-frame");
+  if (!dmabuf_fd.is_valid()) {
+    LOG(ERROR) << "Failed to allocate VCSM-CMA buffer of " << total_size
+               << " bytes";
+    return CroStatus::Codes::kFailedToCreateVideoFrame;
+  }
+
+  // Build the plane layout using NC12 convention: both planes reference the
+  // entire buffer at offset 0.  The ISP / decoder driver handles Y/UV
+  // separation internally within the 128-byte column tiled layout.
+  std::vector<ColorPlaneLayout> planes;
+  planes.emplace_back(aligned_width, /*offset=*/static_cast<size_t>(0),
+                      total_size);
+  planes.emplace_back(aligned_width, /*offset=*/static_cast<size_t>(0),
+                      total_size);
+
+  auto layout = VideoFrameLayout::CreateWithPlanes(
+      format, coded_size, std::move(planes),
+      VideoFrameLayout::kBufferAddressAlignment,
+      gfx::NativePixmapHandle::kNoModifier);
+  if (!layout) {
+    LOG(ERROR) << "Failed to create VideoFrameLayout";
+    return CroStatus::Codes::kFailedToCreateVideoFrame;
+  }
+
+  // Two fds for the two NV12 color planes (Y and UV), both pointing to the
+  // same underlying VCSM-CMA DMABUF at offset 0.  NativePixmapFrameResource
+  // requires one fd per layout plane.
+  base::ScopedFD dmabuf_fd_dup(HANDLE_EINTR(dup(dmabuf_fd.get())));
+  if (!dmabuf_fd_dup.is_valid()) {
+    VPLOG(1) << "Failed to dup VCSM-CMA dmabuf fd";
+    return CroStatus::Codes::kFailedToCreateVideoFrame;
+  }
+  std::vector<base::ScopedFD> dmabuf_fds;
+  dmabuf_fds.push_back(std::move(dmabuf_fd));
+  dmabuf_fds.push_back(std::move(dmabuf_fd_dup));
+
+  scoped_refptr<NativePixmapFrameResource> frame =
+      NativePixmapFrameResource::Create(*layout, visible_rect, natural_size,
+                                        std::move(dmabuf_fds), timestamp);
+  if (!frame) {
+    LOG(ERROR) << "Failed to create NativePixmapFrameResource from VCSM-CMA";
+    return CroStatus::Codes::kFailedToCreateVideoFrame;
+  }
+
+  frame->metadata().allow_overlay = true;
+
+  // Track frame destruction to monitor VCSM-CMA buffer lifecycle.
+  int frame_id = alive_count_.fetch_add(1) + 1;
+  VLOGF(1) << "VCSM-CMA frame #" << frame_id << " created ("
+           << coded_size.ToString() << "), alive=" << frame_id;
+  scoped_refptr<VcsmCmaAllocator> self(this);
+  frame->AddDestructionObserver(base::BindOnce(
+      [](scoped_refptr<VcsmCmaAllocator> allocator, int id) {
+        int remaining = allocator->alive_count_.fetch_sub(1) - 1;
+        VLOG(1) << "VCSM-CMA frame #" << id
+                << " destroyed, alive=" << remaining;
+      },
+      std::move(self), frame_id));
+
+  scoped_refptr<FrameResource> result = std::move(frame);
+  return result;
+}
+
+}  // namespace media
Index: src/media/gpu/v4l2/vcsm_cma_utils.h
===================================================================
--- /dev/null
+++ src/media/gpu/v4l2/vcsm_cma_utils.h
@@ -0,0 +1,66 @@
+// Copyright 2024 The FydeOS Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef MEDIA_GPU_V4L2_VCSM_CMA_UTILS_H_
+#define MEDIA_GPU_V4L2_VCSM_CMA_UTILS_H_
+
+#include <stdint.h>
+
+#include <atomic>
+
+#include "base/files/scoped_file.h"
+#include "media/gpu/chromeos/dmabuf_video_frame_pool.h"
+#include "media/gpu/chromeos/frame_resource.h"
+#include "media/gpu/media_gpu_export.h"
+
+namespace media {
+
+// Allocator that uses /dev/vcsm-cma (VideoCore Shared Memory with CMA) to
+// allocate video frame buffers on Raspberry Pi 4.
+//
+// Buffers allocated via VCSM-CMA are accessible by both ARM CPU and VideoCore
+// firmware, which is required for bcm2835-codec-isp (image processor) to
+// process frames from rpi-hevc-dec (HEVC decoder). Without VCSM-CMA, the ISP
+// cannot import DMABUFs allocated by minigbm's V3D backend because they use
+// different memory domains.
+class MEDIA_GPU_EXPORT VcsmCmaAllocator
+    : public base::RefCountedThreadSafe<VcsmCmaAllocator> {
+ public:
+  VcsmCmaAllocator();
+
+  VcsmCmaAllocator(const VcsmCmaAllocator&) = delete;
+  VcsmCmaAllocator& operator=(const VcsmCmaAllocator&) = delete;
+
+  // Returns true if /dev/vcsm-cma was opened successfully.
+  bool IsValid() const;
+
+  // Allocates a VCSM-CMA buffer and returns its DMABUF file descriptor.
+  base::ScopedFD AllocateBuffer(uint32_t size, const char* name);
+
+  // Creates a FrameResource backed by VCSM-CMA memory.
+  // Matches the DmabufVideoFramePool::CreateFrameCB signature.
+  CroStatus::Or<scoped_refptr<FrameResource>> CreateFrame(
+      VideoPixelFormat format,
+      const gfx::Size& coded_size,
+      const gfx::Rect& visible_rect,
+      const gfx::Size& natural_size,
+      bool use_protected,
+      bool use_linear_buffers,
+      bool needs_detiling,
+      base::TimeDelta timestamp);
+
+ private:
+  friend class base::RefCountedThreadSafe<VcsmCmaAllocator>;
+  ~VcsmCmaAllocator();
+
+  base::ScopedFD vcsm_fd_;
+
+  // Diagnostic tracking for memory leak investigation.
+  std::atomic<int> alloc_count_{0};
+  std::atomic<int> alive_count_{0};
+};
+
+}  // namespace media
+
+#endif  // MEDIA_GPU_V4L2_VCSM_CMA_UTILS_H_
