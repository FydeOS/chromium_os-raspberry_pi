+// Raspberry Pi 128-byte column tiled format for hardware video decoder.
+#ifndef V4L2_PIX_FMT_NV12_COL128
+#define V4L2_PIX_FMT_NV12_COL128 v4l2_fourcc('N', 'C', '1', '2')
+#endif
+
 #define MAKE_V4L2_CODEC_PAIR(codec, suffix) \
   std::make_pair(codec##_##suffix, codec)
 
@@ -287,6 +292,31 @@ std::optional<VideoFrameLayout> V4L2Form
                             y_stride_abs * pix_mp.height / 2);
         DCHECK_EQ(2u, planes.size());
         break;
+#ifdef V4L2_PIX_FMT_NV12_COL128
+      case V4L2_PIX_FMT_NV12_COL128: {
+        // NV12_COL128: 128-byte column tiled format (Raspberry Pi).
+        // V4L2 bytesperline = column height (Y height + UV height = H*3/2).
+        // V4L2 sizeimage = bytesperline * width (single plane buffer).
+        //
+        // Each column is 128 bytes wide x col_height rows:
+        //   rows [0, H): Y data
+        //   rows [H, H*3/2): interleaved UV data
+        //
+        // We import the entire buffer for both planes with stride=width,
+        // offset=0. The shader handles Y/UV offset within each column.
+        const int32_t col128_stride =
+            static_cast<int32_t>(pix_mp.width);
+        const size_t col128_stride_abs = static_cast<size_t>(col128_stride);
