ACTION!="add", GOTO="media_end"
KERNEL=="media*", DRIVERS=="rpi-hevc-dec", SYMLINK+="media-dec0"
KERNEL=="media*", DRIVERS=="rpi-hevc-dec", GROUP="video"
KERNEL=="media*", DRIVERS=="rpi-hevc-dec", ENV{MEDIA_DEVICE_TYPE}="decoder"
SUBSYSTEM!="video4linux", GOTO="media_end"

#KERNEL=="video10", SYMLINK+="video-dec0"
#KERNEL=="video11", SYMLINK+="video-enc0"
#KERNEL=="video12", SYMLINK+="image-proc0"
#KERNEL=="video31", SYMLINK+="jpeg-enc0"
#KERNEL=="video19", SYMLINK+="video-dec0"
ATTR{name}=="rpi-hevc-dec", SYMLINK+="video-dec0"

LABEL="media_end"
